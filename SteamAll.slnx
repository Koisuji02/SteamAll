         compilato in Debug (configurazione predefinita) e il nucleo non trova il suo exe in bin\Release. -->
    <Project Path="src/SteamAll.Launcher/SteamAll.Launcher.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/SteamAll.Tests/SteamAll.Tests.csproj" />
  </Folder>
</Solution>
